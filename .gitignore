# Credentials and local configuration — never commit.
#
# These patterns match credential *files* someone might drop into a working
# copy. They deliberately do not match source modules: a bare `credentials*`
# rule once swallowed `nautilus_gateio/common/credentials.py`, which imports
# fine locally and fails only in a clean checkout. Match secret-shaped
# suffixes, not bare names;
# tests/test_package.py::TestVersionControlCoverage::test_no_ignore_rule_matches_a_source_module
# enforces the difference by running `git check-ignore` over every source file.
.env
.env.*
*.env
credentials.json
credentials.yaml
credentials.yml
credentials.ini
credentials.txt
secrets.json
secrets.yaml
secrets.yml
secrets.ini
secrets.txt
*.pem
*.key
*.p12

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
wheels/
.venv/
venv/
env/

# Testing / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Local data / logs
*.log
*.sqlite
*.db
data/
logs/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

